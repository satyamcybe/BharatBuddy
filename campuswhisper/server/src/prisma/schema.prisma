generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Resource {
  id        String   @id @default(uuid())
  roomId    String
  title     String
  url       String
  tag       String
  votes     Int      @default(0)
  pinnedBy  String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Report {
  id          String   @id @default(uuid())
  messageId   String
  reason      String
  reportCount Int      @default(1)
  createdAt   DateTime @default(now())
}
